# Copy to .env and fill in. Never commit .env.
#
# Nothing here is needed to try the offline demo:
#     python senrew.py demo

# --- Model -----------------------------------------------------------------
# Your own key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier quota is per model, so if one is exhausted another may still work.
# Verified with function calling: gemini-3.5-flash, gemini-3.6-flash,
# gemini-3.1-flash-lite, gemini-flash-latest.
GEMINI_MODEL=gemini-3.5-flash
MAX_OUTPUT_TOKENS=4096
TEMPERATURE=0
MAX_RETRIES=3

# Free keys allow only a few requests per minute and an agent spends one per
# step, so a review will pause partway through. SenRew waits exactly as long
# as Google asks, up to RATE_LIMIT_MAX_WAIT, this many times.
RATE_LIMIT_RETRIES=6
RATE_LIMIT_MAX_WAIT=75

# Hard ceiling on tool-calling steps per agent run. The single most important
# setting here: without it a loop can keep calling tools until quota is gone.
MAX_STEPS=12

# Canned model output instead of a real call, for running with no key.
USE_FAKE_MODEL=false

# Used only for the cost line. Check https://ai.google.dev/pricing
PRICE_INPUT_PER_MTOK=1.50
PRICE_OUTPUT_PER_MTOK=9.00


# --- GitHub ----------------------------------------------------------------
# Your own token, with 'repo' scope. It never leaves your machine.
GITHUB_TOKEN=


# --- Tool limits -----------------------------------------------------------
MAX_FILE_LINES=400
MAX_SEARCH_RESULTS=20
MAX_TOOL_CHARS=12000


# --- Review behaviour ------------------------------------------------------
MIN_SEVERITY_TO_POST=low
MAX_COMMENTS_PER_REVIEW=15

# The second agent that tries to disprove the first one's findings.
VERIFY=true


# --- Watcher ---------------------------------------------------------------
WATCH_INTERVAL_SECONDS=15
